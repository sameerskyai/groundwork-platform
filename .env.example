# Laywork / Groundwork -- environment variable NAMES ONLY.
#
# Never put a real value in this file. It is committed. Real values go in
# .env.local (gitignored) locally and in the Vercel project settings in
# production.
#
# Copy to .env.local and fill in.

# ---------------------------------------------------------------- Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------------------------- App
# Absolute origin, no trailing slash. Used for referral links and the
# unsubscribe link inside every email, so it MUST be the real public origin
# in production or the unsubscribe link points at localhost.
NEXT_PUBLIC_APP_URL=

# --------------------------------------------------------------------- AI
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------- Email
# Provider: Resend (see DECISIONS.md 2026-07-27 for why over Postmark).
# Server only. Read by lib/email/config.ts from process.env, never written
# to disk, never logged, never returned in an API response.
RESEND_API_KEY=

# Optional. Only set if switching providers; lib/email supports both.
# POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=
# EMAIL_PROVIDER=resend

# RFC 5322 sender. FOUNDER ACTION: after verifying the sending domain in the
# Resend dashboard, set this to an address on that domain, e.g.
# "Laywork <hello@laywork.com>". Until then lib/email falls back to Resend's
# shared onboarding@resend.dev, which can only deliver to the account owner's
# own address.
EMAIL_FROM=

# Optional. Where replies go if it is not the From address.
EMAIL_REPLY_TO=

# FOUNDER ACTION, REQUIRED BEFORE PUBLIC LAUNCH. CAN-SPAM (15 U.S.C.
# 7704(a)(5)) requires a valid physical postal address in every commercial
# message. Until this is set, every email footer renders a visible
# "[FOUNDER ACTION REQUIRED...]" placeholder instead of quietly omitting it.
EMAIL_POSTAL_ADDRESS=

# HMAC key for unsubscribe tokens. Falls back to SUPABASE_SERVICE_ROLE_KEY if
# unset, but set it explicitly in production: rotating the service-role key
# would otherwise invalidate every unsubscribe link already in someone's
# inbox. Any long random string.
EMAIL_UNSUBSCRIBE_SECRET=
